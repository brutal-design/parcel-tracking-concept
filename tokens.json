{
  "$description": "Експорт з Figma Variables, колекція «Трекінг · Tokens». Джерело правди для коду. Кольори тільки hex.",
  "color": {
    "ink": {
      "950": {
        "$type": "color",
        "$value": "#15171C"
      },
      "600": {
        "$type": "color",
        "$value": "#545B67"
      },
      "400": {
        "$type": "color",
        "$value": "#8C929D"
      },
      "200": {
        "$type": "color",
        "$value": "#E2E5EA"
      }
    },
    "paper": {
      "0": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "50": {
        "$type": "color",
        "$value": "#F4F5F7"
      }
    },
    "signal": {
      "600": {
        "$type": "color",
        "$value": "#D42A1E"
      },
      "700": {
        "$type": "color",
        "$value": "#B02218"
      },
      "50": {
        "$type": "color",
        "$value": "#FDEDEB"
      }
    },
    "green": {
      "700": {
        "$type": "color",
        "$value": "#12704F"
      },
      "50": {
        "$type": "color",
        "$value": "#E6F4EE"
      }
    },
    "amber": {
      "800": {
        "$type": "color",
        "$value": "#8A4B00"
      },
      "50": {
        "$type": "color",
        "$value": "#FFF3DC"
      }
    },
    "blue": {
      "600": {
        "$type": "color",
        "$value": "#2456D6"
      }
    }
  },
  "semantic": {
    "bg": {
      "$type": "color",
      "$value": "{color.paper.50}"
    },
    "surface": {
      "$type": "color",
      "$value": "{color.paper.0}"
    },
    "text": {
      "$type": "color",
      "$value": "{color.ink.950}"
    },
    "text-muted": {
      "$type": "color",
      "$value": "{color.ink.600}"
    },
    "line": {
      "$type": "color",
      "$value": "{color.ink.200}"
    },
    "accent": {
      "$type": "color",
      "$value": "{color.signal.600}"
    },
    "accent-hover": {
      "$type": "color",
      "$value": "{color.signal.700}"
    },
    "accent-soft": {
      "$type": "color",
      "$value": "{color.signal.50}"
    },
    "on-accent": {
      "$type": "color",
      "$value": "{color.paper.0}"
    },
    "success": {
      "$type": "color",
      "$value": "{color.green.700}"
    },
    "success-bg": {
      "$type": "color",
      "$value": "{color.green.50}"
    },
    "warning": {
      "$type": "color",
      "$value": "{color.amber.800}"
    },
    "warning-bg": {
      "$type": "color",
      "$value": "{color.amber.50}"
    },
    "focus": {
      "$type": "color",
      "$value": "{color.blue.600}"
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "12px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "20px"
    },
    "full": {
      "$type": "dimension",
      "$value": "999px"
    }
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": [
        "Onest",
        "system-ui",
        "sans-serif"
      ]
    }
  },
  "size": {
    "xs": {
      "$type": "dimension",
      "$value": "13px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "15px"
    },
    "base": {
      "$type": "dimension",
      "$value": "17px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "20px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "24px"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "32px"
    },
    "3xl": {
      "$type": "dimension",
      "$value": "44px"
    }
  }
}